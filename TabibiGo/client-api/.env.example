# Copy this file to .env and fill in your real values

PORT=5000
NODE_ENV=development

# Database
MONGO_URI=
MONGO_DB_NAME=TabibiGo-Users

# JWT — Client Access Token
JWT_SECRET=
JWT_EXPIRES_IN=15m

# JWT — Client Refresh Token
REFRESH_SECRET=
REFRESH_EXPIRES_IN=7d

# OTP HMAC Secret
OTP_SECRET=

# SMTP (Gmail)
SMTP_EMAIL=
SMTP_APP_PASSWORD=
